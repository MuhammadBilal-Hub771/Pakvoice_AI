# PakVoice AI - backend configuration
#
# Copy to .env and fill in. Never commit .env.

# === App ===
APP_NAME=PakVoice API
VERSION=1.0.0
# Keep false in production. DEBUG enables demo user seeding and the Google
# OAuth dev auto-login, both of which hand out working sessions.
DEBUG=false

# === Auth ===
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# === Google OAuth (optional) ===
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# === OpenAI ===
OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=1500

# === Database: Supabase Postgres ===
# Leave empty to use the local JSON files under backend/data/ (development
# only — no locking, concurrent writes are lost).
#
# Supabase dashboard > Project Settings > Database > Connection string > URI.
# Prefer the connection pooler (port 6543) for serverless or many-instance
# deploys; use the direct connection (port 5432) for a single long-lived
# process. Run db/schema.sql once before starting the app.
SUPABASE_DB_URL=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=1800

# === Supabase Storage ===
# Without these, uploads and generated images go to local disk and are lost
# when the container is replaced. Also required for the WhatsApp bot to send
# images, since Meta fetches the URL from its own servers.
#
# Create two private buckets named below, then use the service_role key
# (Project Settings > API). It bypasses row level security — server only.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_DOCUMENTS_BUCKET=documents
SUPABASE_IMAGES_BUCKET=images
SIGNED_URL_TTL_SECONDS=604800

# === RAG ===
# Used only when SUPABASE_DB_URL is empty; otherwise pgvector is used.
CHROMA_PERSIST_DIR=./chroma_db
COLLECTION_NAME=contentpk_kb
EMBEDDING_MODEL=text-embedding-3-small
# Must match the vector(N) dimension in db/schema.sql. Changing the embedding
# model means recreating document_chunks and re-uploading documents.
EMBEDDING_DIMENSIONS=1536
RAG_TOP_K=3

# === Image generation ===
IMAGE_MODEL=gpt-image-2
IMAGE_SIZE=1024x1024
IMAGE_QUALITY=high
IMAGE_STORAGE_DIR=./generated_images

# === Speech to text ===
WHISPER_MODEL=whisper-1
WHISPER_MAX_FILE_MB=25

# === Client Content Agent ===
# Leave AGENT_MODEL empty to reuse OPENAI_MODEL.
AGENT_MODEL=
AGENT_MAX_STEPS=12
AGENT_REQUIRE_VALIDATION=true
AGENT_MAX_REFINE_ITERATIONS=3

# === Web Search (live) ===
# Enables the agent's web_search / scrape_page tools. The default provider is
# DuckDuckGo and needs no key; set a paid provider to override it.
WEB_SEARCH_ENABLED=true
WEB_SEARCH_MAX_RESULTS=5
WEB_SCRAPE_MAX_CHARS=6000
SERPER_API_KEY=
TAVILY_API_KEY=

# === WhatsApp Cloud API ===
# See docs/DEPLOYMENT.md for the Meta app setup walkthrough.
WHATSAPP_ENABLED=false
WHATSAPP_API_VERSION=v21.0
# Meta app dashboard > WhatsApp > API Setup
WHATSAPP_PHONE_NUMBER_ID=
# The number users actually message, e.g. +92 300 1234567. Shown in the UI.
WHATSAPP_DISPLAY_NUMBER=
# Permanent System User token, not the 24-hour temporary one
WHATSAPP_ACCESS_TOKEN=
# A string you invent; must match what you enter in the Meta webhook form
WHATSAPP_VERIFY_TOKEN=
# App Settings > Basic > App Secret. Used to verify webhook signatures.
WHATSAPP_APP_SECRET=
WHATSAPP_MAX_MESSAGES_PER_MINUTE=10
WHATSAPP_LINK_CODE_TTL_MINUTES=15

# === Files ===
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
ALLOWED_EXTENSIONS=.txt,.md,.pdf,.docx

# === Rate limiting ===
RATE_LIMIT=30/minute
RATE_LIMIT_GENERATE=10/minute
RATE_LIMIT_IMAGE=5/minute
RATE_LIMIT_STT=15/minute
RATE_LIMIT_AGENT=8/minute

# === CORS and URLs ===
# Comma-separated. Must list the exact frontend origins.
ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
